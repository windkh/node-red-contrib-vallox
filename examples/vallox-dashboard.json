    {
        "id": "30015a195a333",
        "type": "function",
        "z": "e1a2b3c4d5f60003",
        "name": "Stoßlüftung schalten",
        "func": "// Das Protokoll kennt keine \"Stoßlüftung für N Minuten\": 79H ist nur der lesbare\n// Restzeit-Zähler der Anlage. Also läuft die Dauer hier: aktuelle Stufe merken, auf\n// Maximum gehen und nach Ablauf zurückstellen. Der Ticker unten prüft die Zeit.\nconst state = flow.get(\"vallox\") || {};\nconst start = msg.payload === true;\nlet out = null;\n\nif (start && (state.FanSpeed === undefined || state.FanSpeedMax === undefined)) {\n    node.warn(\"Lüfterstufe noch nicht abgefragt - bitte einen Moment warten\");\n    out = [null, { payload: \"-\" }, { payload: false }];\n} else if (start) {\n    const minutes = Number(flow.get(\"boostMinutes\")) || 30;\n    flow.set(\"boostPrevious\", state.FanSpeed);\n    flow.set(\"boostUntil\", Date.now() + minutes * 60000);\n    out = [\n        { payload: { request: \"SET\", variable: \"FanSpeed\", value: state.FanSpeedMax } },\n        { payload: minutes + \" min\" },\n        null,\n    ];\n} else {\n    const previous = flow.get(\"boostPrevious\");\n    flow.set(\"boostUntil\", null);\n    flow.set(\"boostPrevious\", null);\n    const restore =\n        previous === undefined || previous === null\n            ? null\n            : { payload: { request: \"SET\", variable: \"FanSpeed\", value: previous } };\n    out = [restore, { payload: \"aus\" }, null];\n}\n\nreturn out;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 640,
        "wires": [
            [
                "300058ff34739"
            ],
            [
                "3001328b7bc6f"
            ],
            [
                "30015035e2982"
            ]
        ]
    },
    {
        "id": "300163fcd1ce4",
        "type": "function",
        "z": "e1a2b3c4d5f60003",
        "name": "Stoßlüftung überwachen",
        "func": "// Wird vom Abfrage-Timer mitgetaktet: zählt die Restzeit herunter und stellt die vorherige\n// Lüfterstufe wieder her, sobald die Stoßlüftung abgelaufen ist.\nconst until = flow.get(\"boostUntil\");\nlet out = null;\n\nif (until) {\n    const remaining = Math.ceil((until - Date.now()) / 60000);\n    if (remaining > 0) {\n        out = [null, { payload: remaining + \" min\" }, null];\n    } else {\n        const previous = flow.get(\"boostPrevious\");\n        flow.set(\"boostUntil\", null);\n        flow.set(\"boostPrevious\", null);\n        const restore =\n            previous === undefined || previous === null\n                ? null\n                : { payload: { request: \"SET\", variable: \"FanSpeed\", value: previous } };\n        out = [restore, { payload: \"aus\" }, { payload: false }];\n    }\n}\n\nreturn out;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 680,
        "wires": [
            [
                "300058ff34739"
            ],
            [
                "3001328b7bc6f"
