    {
        "id": "30010afd9d5ab",
        "type": "function",
        "z": "e1a2b3c4d5f60003",
        "name": "Wirkungsgrad",
        "func": "// Kein Register: der Wirkungsgrad wird aus den vier Temperaturen berechnet.\n//     Wirkungsgrad Zuluft = (Zuluft - Außenluft) / (Abluft - Außenluft)\n// Das ist die übliche Definition und auch die Rechnung der valloxserial-Bibliothek.\n//\n// Sie gilt nur in der Heizperiode. Der Nenner (Abluft - Außenluft) wird im Sommer klein\n// oder negativ, und dann liefert die Formel Unsinn: bei 28 °C außen, 24 °C Abluft und\n// 22 °C Zuluft kommen 150 % heraus. Die Sensoren lösen nur etwa 1 K auf, bei 2 K Spanne\n// verschiebt ein Grad Messfehler das Ergebnis also um 50 Prozentpunkte.\n// Darum wird unterhalb einer Mindestspanne nichts angezeigt.\nconst MIN_SPAN = 3; // Kelvin\n\nconst s = msg.payload;\nconst needed = [s.TemperatureInside, s.TemperatureOutside, s.TemperatureIncoming, s.TemperatureExhaust];\nconst span = s.TemperatureInside - s.TemperatureOutside;\nlet result = null;\n\nif (needed.some((v) => v === undefined)) {\n    result = null;\n} else if (span < MIN_SPAN) {\n    const hint = { payload: \"-\" };\n    result = [hint, hint, hint];\n} else {\n    const zu = ((s.TemperatureIncoming - s.TemperatureOutside) * 100) / span;\n    const ab = ((s.TemperatureInside - s.TemperatureExhaust) * 100) / span;\n    // über 100 % heißt: die Nachheizung wärmt die Zuluft zusätzlich auf\n    const pct = (v) => Math.round(v) + \" %\";\n    result = [{ payload: pct(zu) }, { payload: pct(ab) }, { payload: pct((zu + ab) / 2) }];\n}\n\nreturn result;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 440,
        "wires": [
            [
                "3000ed5336898"
            ],
            [
                "3000f736ae249"
            ],
            [
                "3001011a25bfa"
            ]
        ]
    },
