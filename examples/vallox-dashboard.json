        "name": "SET Select.PowerState",
        "func": "// A3H Bits 0-3 sind die Bedientasten. Lesen, ein Feld ändern, zurückschreiben - so\n// gehen die nur lesbaren Anzeigebits unverändert zurück.\nconst select = Object.assign({}, (flow.get(\"vallox\") || {}).Select);\nlet out = null;\n\nif (select.PowerState === undefined) {\n    node.warn(\"Select noch nicht abgefragt - bitte einen Moment warten\");\n} else {\n    select.PowerState = msg.payload === true;\n    msg.payload = { request: \"SET\", variable: \"Select\", value: select };\n    out = msg;\n}\n\nreturn out;",
