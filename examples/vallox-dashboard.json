    {
        "id": "30015035e2982",
        "type": "function",
        "z": "e1a2b3c4d5f60003",
        "name": "SET Select.PowerState",
        "func": "// A3H bits 0-3 are the panel keys. Read, change one field, write it back - that way\n// the read-only indicator bits go back untouched.\nconst select = Object.assign({}, (flow.get(\"vallox\") || {}).Select);\nlet out = null;\n\nif (select.PowerState === undefined) {\n    node.warn(\"Select not polled yet - wait a moment\");\n} else {\n    select.PowerState = msg.payload === true;\n    msg.payload = { request: \"SET\", variable: \"Select\", value: select };\n    out = msg;\n}\n\nreturn out;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 600,
        "wires": [
            [
                "30004f1bbcd88"
            ]
        ]
