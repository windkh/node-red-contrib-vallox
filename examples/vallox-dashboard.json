        "z": "e1a2b3c4d5f60003",
        "name": "nächstes Register abfragen",
        "func": "// Nur 2AH, 2BH, 2CH und 32H-35H kommen unaufgefordert. Alles andere muss abgefragt werden -\n// eines pro Takt, damit der Bus ruhig bleibt: die Bedienteile fragen auch ab.\nconst registers = [\"FanSpeed\",\"Select\",\"IoPortMultiPurpose2\",\"LastErrorNumber\",\"HeatingSetPoint\",\"PreHeatingSetPoint\",\"HRCBypass\",\"FanSpeedMin\",\"FanSpeedMax\",\"DCFanInputAdjustment\",\"DCFanOutputAdjustment\"];\nconst i = (context.get(\"i\") || 0) % registers.length;\ncontext.set(\"i\", i + 1);\nmsg.payload = { request: \"GET\", variable: registers[i] };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
