    {
        "id": "300128a8042be",
        "type": "function",
        "z": "e1a2b3c4d5f60003",
        "name": "boost switch",
        "func": "// The protocol has no \"boost for N minutes\": 79H is only the read-only countdown the unit\n// keeps itself. So the duration is driven here - remember the current speed, go to maximum\n// and put it back when the time is up. The timer below watches the clock.\nconst state = flow.get(\"vallox\") || {};\nconst start = msg.payload === true;\nlet out = null;\n\nif (start && (state.FanSpeed === undefined || state.FanSpeedMax === undefined)) {\n    node.warn(\"fan speed not polled yet - wait a moment\");\n    out = [null, { payload: \"-\" }, { payload: false }];\n} else if (start) {\n    const minutes = Number(flow.get(\"boostMinutes\")) || 30;\n    flow.set(\"boostPrevious\", state.FanSpeed);\n    flow.set(\"boostUntil\", Date.now() + minutes * 60000);\n    out = [\n        { payload: { request: \"SET\", variable: \"FanSpeed\", value: state.FanSpeedMax } },\n        { payload: minutes + \" min\" },\n        null,\n    ];\n} else {\n    const previous = flow.get(\"boostPrevious\");\n    flow.set(\"boostUntil\", null);\n    flow.set(\"boostPrevious\", null);\n    const restore =\n        previous === undefined || previous === null\n            ? null\n            : { payload: { request: \"SET\", variable: \"FanSpeed\", value: previous } };\n    out = [restore, { payload: \"aus\" }, null];\n}\n\nreturn out;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 480,
        "wires": [
            [
                "30004f1bbcd88"
            ],
            [
                "3001011a25bfa"
            ],
            [
                "30011ec48c90d"
            ]
        ]
    },
    {
        "id": "3001328b7bc6f",
        "type": "function",
        "z": "e1a2b3c4d5f60003",
        "name": "boost timer",
        "func": "// Driven by the poll timer: counts the remaining minutes down and restores the previous\n// fan speed once the boost has run out.\nconst until = flow.get(\"boostUntil\");\nlet out = null;\n\nif (until) {\n    const remaining = Math.ceil((until - Date.now()) / 60000);\n    if (remaining > 0) {\n        out = [null, { payload: remaining + \" min\" }, null];\n    } else {\n        const previous = flow.get(\"boostPrevious\");\n        flow.set(\"boostUntil\", null);\n        flow.set(\"boostPrevious\", null);\n        const restore =\n            previous === undefined || previous === null\n                ? null\n                : { payload: { request: \"SET\", variable: \"FanSpeed\", value: previous } };\n        out = [restore, { payload: \"aus\" }, { payload: false }];\n    }\n}\n\nreturn out;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 520,
        "wires": [
            [
                "30004f1bbcd88"
            ],
            [
                "3001011a25bfa"
            ],
            [
                "30011ec48c90d"
            ]
        ]
    },
