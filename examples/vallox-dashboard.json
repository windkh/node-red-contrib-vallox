    {
        "id": "3002be162c017",
        "type": "function",
        "z": "e1a2b3c4d5f60003",
        "name": "poll next register",
        "func": "// Only 2AH, 2BH, 2CH and 32H-35H arrive unasked. Everything else has to be polled - one\n// per tick, so the bus stays quiet: the physical panels are polling too.\nconst registers = [\"FanSpeed\",\"Select\",\"IoPortMultiPurpose2\",\"LastErrorNumber\",\"HeatingSetPoint\",\"PreHeatingSetPoint\",\"HRCBypass\",\"FanSpeedMin\",\"FanSpeedMax\",\"DCFanInputAdjustment\",\"DCFanOutputAdjustment\"];\nconst i = (context.get(\"i\") || 0) % registers.length;\ncontext.set(\"i\", i + 1);\nmsg.payload = { request: \"GET\", variable: registers[i] };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 1520,
        "wires": [
            [
                "30004f1bbcd88"
            ]
        ]
    },
    {
        "id": "3002c7f9a39c8",
