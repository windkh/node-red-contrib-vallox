{
    "name": "node-red-contrib-vallox",
    "version": "0.1.38",
    "description": "Vallox node for serial RS485 protocol.",
    "files": [
        "vallox/",
        "examples/",
        "CHANGELOG.md"
    ],
    "node-red": {
        "version": ">=3.1.0",
        "nodes": {
            "vallox": "vallox/99-vallox.js"
        }
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "node-red",
        "vallox"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/windkh/node-red-contrib-vallox"
    },
    "author": "Karl-Heinz Wind",
    "license": "MIT",
    "scripts": {
        "lint": "eslint vallox/ test/ tools/ eslint.config.js",
        "test": "node --test --test-timeout=30000 --test-concurrency=1",
        "lint:fix": "eslint vallox/ test/ tools/ eslint.config.js --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "coverage": "c8 npm test",
        "coverage:check": "c8 --check-coverage npm test",
        "standards:audit": "nrstd audit",
        "standards:sync": "nrstd sync"
    },
    "c8": {
        "reporter": [
            "text",
            "lcov"
        ],
        "lines": 97,
        "statements": 97,
        "branches": 95,
        "functions": 98,
        "exclude": [
            "test/**",
            "eslint.config.js"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "c8": "^12.0.0",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "node-red": "^3.1.0",
        "node-red-node-test-helper": "^0.3.4",
        "node-red-standards": "github:windkh/node-red-standards",
        "prettier": "^3.0.0"
    }
}
