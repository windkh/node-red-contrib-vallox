{
    "name": "node-red-contrib-vallox",
    "version": "0.1.17",
    "description": "Vallox node for serial RS485 protocol.",
    "files": [
        "vallox/",
        "examples/",
        "CHANGELOG.md"
    ],
    "node-red": {
        "version": ">=0.1.0",
        "nodes": {
            "vallox": "vallox/99-vallox.js"
        }
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "node-red",
        "vallox"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/windkh/node-red-contrib-vallox"
    },
    "author": "Karl-Heinz Wind",
    "license": "MIT",
    "scripts": {
        "lint": "eslint vallox/ test/",
        "test": "node --test",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "coverage": "c8 node --test",
        "coverage:check": "c8 --check-coverage node --test"
    },
    "c8": {
        "lines": 78,
        "statements": 78,
        "branches": 71,
        "functions": 63,
        "exclude": [
            "test/**",
            "eslint.config.js"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "eslint": "^9.39.4",
        "globals": "^17.6.0",
        "node-red": "^3.1.0",
        "node-red-node-test-helper": "^0.3.4",
        "eslint-config-prettier": "^9.0.0",
        "prettier": "^3.0.0",
        "c8": "^10.0.0"
    }
}
